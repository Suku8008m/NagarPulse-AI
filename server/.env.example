# NagarPulse AI Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/nagarpulse_ai

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client Application URL
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# HTTPS REST Email Gateway (Bypasses Render outbound blocked SMTP ports 465/587)
# Brevo REST API: https://api.brevo.com/v3/smtp/email
# BREVO_API_KEY=your_brevo_api_key_here
# BREVO_SENDER_EMAIL=noreply@nagarpulse.in
# BREVO_SENDER_NAME=NagarPulse AI
#
# Resend REST API: https://api.resend.com/emails
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=NagarPulse AI <onboarding@resend.dev>

# Optional Mobile SMS REST Gateway (Twilio / Fast2SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
# FAST2SMS_API_KEY=your_fast2sms_api_key
