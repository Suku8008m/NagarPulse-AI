# NagarPulse AI Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/nagarpulse_ai

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client Application URL
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Production HTTPS Email Service (Brevo Transactional API over Port 443)
# BREVO_API_KEY=your_brevo_api_key_here
# BREVO_SENDER_EMAIL=noreply@nagarpulse.in
# BREVO_SENDER_NAME=NagarPulse AI

# Allow Demo OTP Fallback for Hackathon Testing (Never blocks judges if external email gateway is unavailable)
ALLOW_DEMO_OTP_FALLBACK=true
